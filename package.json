{
  "name": "resellpilot",
  "private": true,
  "version": "0.0.1",
  "type": "module",
  "packageManager": "pnpm@9.15.0",
  "engines": {
    "node": ">=20.12"
  },
  "scripts": {
    "dev": "pnpm --filter @resellpilot/server dev",
    "dev:ext": "pnpm --filter @resellpilot/extension dev",
    "start": "pnpm --filter @resellpilot/dashboard build && pnpm --filter @resellpilot/server start",
    "build": "pnpm -r build",
    "test": "pnpm -r test",
    "lint": "eslint . && pnpm -r typecheck"
  },
  "devDependencies": {
    "@eslint/js": "^9.17.0",
    "eslint": "^9.17.0",
    "globals": "^15.14.0",
    "typescript": "^5.7.2",
    "typescript-eslint": "^8.18.0"
  }
}
