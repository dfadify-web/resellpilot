# Copia este archivo a .env y rellena lo que necesites.
# El server escucha SIEMPRE en 127.0.0.1 (no configurable).

# Puerto local del server + dashboard
PORT=4317

# Ruta de la base de datos SQLite (relativa a la raíz del repo o absoluta)
DB_PATH=./data/resellpilot.db

# Abrir el navegador al arrancar `pnpm dev` (true|false)
OPEN_BROWSER=true

# Bot propio de Telegram para notificaciones. Créalo con @BotFather y pega aquí su token.
TELEGRAM_BOT_TOKEN=
# Opcional: si lo dejas vacío, se detecta solo cuando envíes /start a tu bot.
TELEGRAM_CHAT_ID=

# ID de la extensión de Chrome, para CORS (Fase 3). Se ve en chrome://extensions.
EXTENSION_ID=
